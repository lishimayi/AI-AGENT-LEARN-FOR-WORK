    "auto_audit_rules": [
      {"rule_id": "AR-001", "description": "证件照片清晰度不足", "action": "自动拒绝，要求重新上传"},
      {"rule_id": "AR-002", "description": "证件信息与录入信息不一致", "action": "自动拒绝"},
      {"rule_id": "AR-003", "description": "人脸比对相似度 < 80%", "action": "自动拒绝"},
      {"rule_id": "AR-004", "description": "活体检测未通过", "action": "自动拒绝，提示重试"},
      {"rule_id": "AR-005", "description": "证件有效期已过", "action": "自动拒绝"},
      {"rule_id": "AR-006", "description": "证件号已被其他账号使用", "action": "自动拒绝，转人工复核"},
      {"rule_id": "AR-007", "description": "用户年龄 < 18岁", "action": "自动拒绝"},
      {"rule_id": "AR-008", "description": "用户在黑名单中", "action": "自动拒绝，通知风控"}
    ],
    "audit_time_requirements": [
