      "目标": [
        "实现用户身份信息的收集、验证与管理",
        "支持多等级认证（基础认证、高级认证、企业认证）",
        "满足监管机构的合规要求",
        "提供安全、高效、用户体验友好的认证流程"
      ]
    },
    "certification_levels": [
